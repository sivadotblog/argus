# Argus environment. Copy to .env and fill in. Never commit .env.
# Full list and meaning: README.md, "Environment variables".

# --- public (no credentials) ---
# Test-only overrides; leave unset in production.
# SNOWFLAKE_STATUS_BASE_URL=
# DATABRICKS_STATUS_BASE_URL=
# HASHICORP_STATUS_BASE_URL=
# WEB_CHECK_URL=

# --- azure (service principal with Monitoring Reader on the subscription) ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- atlas (organization or project API key, read-only) ---
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_PROJECT=

# --- snowflake-logs (role with IMPORTED PRIVILEGES on the SNOWFLAKE database) ---
# SNOWFLAKE_ACCOUNT is the account identifier, for example orgname-accountname.
# URL-encode special characters in SNOWFLAKE_PASSWORD.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
# First tracking value, format YYYY-MM-DDTHH24:MI:SS.FF9+00:00. Optional.
# SNOWFLAKE_LOGS_START=

# --- splunk (only when the splunk_hec block in config/base.yaml is uncommented) ---
SPLUNK_HEC_ENDPOINT=
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=
